      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "server"
    },
    "payload": {
      "type": "object"
    }
  },
