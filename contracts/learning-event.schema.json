      "type": "string",
      "format": "uuid"
    },
    "school_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_revision": {
